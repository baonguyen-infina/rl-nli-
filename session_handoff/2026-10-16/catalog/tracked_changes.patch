+    ap.add_argument('--runs',nargs='+')
+    ap.add_argument('--split',choices=['dev','test'],default='dev')
+    ap.add_argument('--out',type=Path,default=ARTIFACTS/'analysis'/'runs.csv');a=ap.parse_args()
+    rows=collect_runs(a.results,a.split)
